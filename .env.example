# Jira (shared across Tickets Automation, OSD -> IMAP, Close Tickets)
JIRA_SERVER=https://getaltadx.atlassian.net
JIRA_EMAIL=you@getaltadx.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=OSD

# OSD -> IMAP copier
JIRA_TARGET_PROJECT=IMAP
JIRA_TARGET_ISSUE_TYPE=Task
JIRA_TARGET_STATUS=In Review

# MongoDB (Chats Review + Tickets Automation session lookup)
mongo_connection_string=<your_mongodb_url>
mongo_database=<your_mongodb_name>
mongo_collection=<your_mongo_collection>